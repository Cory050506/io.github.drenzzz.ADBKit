<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.drenzzz.ADBKit</id>

  <name>ADBKit</name>
  <summary>ADB, Fastboot and scrcpy toolkit</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>

  <developer id="io.github.drenzzz">
    <name>Drenzzz</name>
  </developer>

  <description>
    <p>
      ADBKit puts Android device management, app and file operations, a terminal,
      logcat, flashing and scrcpy controls in one desktop app.
    </p>
    <ul>
      <li>Switch between devices and connect over USB or wireless ADB, including pairing</li>
      <li>Install, uninstall, enable and disable apps, and pull APK files</li>
      <li>Browse device storage and push or pull files and folders</li>
      <li>Flash partitions, review a flash plan for a ROM folder, manage A/B slots and sideload ZIPs</li>
      <li>ADB shell, ADB host and Fastboot terminals, plus a filterable logcat stream</li>
      <li>Mirror and record the device screen with scrcpy</li>
    </ul>
    <p>
      The setup wizard can download Android Platform Tools and scrcpy on first run
      and verifies them against pinned checksums.
    </p>
    <p>
      To access a phone over USB, your system needs udev rules for Android
      devices (most distributions ship them in android-udev or similar packages).
    </p>
  </description>

